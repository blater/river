{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riverdb.io/schemas/benchmark/manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "evidence_class",
    "run_id",
    "created_at",
    "river_commit",
    "environment",
    "workloads",
    "measurement",
    "canonical_gaps"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "manifest"},
    "evidence_class": {"const": "local_smoke"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
    "created_at": {"type": "string", "minLength": 20},
    "river_commit": {"type": "string", "minLength": 1},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "java_runtime", "java_vm", "available_processors"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "java_runtime": {"type": "string", "minLength": 1},
        "java_vm": {"type": "string", "minLength": 1},
        "available_processors": {"type": "integer", "minimum": 1}
      }
    },
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "seed", "record_count", "config", "sha256"],
        "properties": {
          "name": {"type": "string", "enum": ["riverbank_tiny", "riverpapers_tiny"]},
          "version": {"type": "integer", "minimum": 1},
          "seed": {"type": "integer"},
          "record_count": {"type": "integer", "minimum": 1},
          "config": {"type": "string", "pattern": "^schema=partial_tiny_v1;.+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clock", "highest_trackable_ns", "significant_digits", "modes"],
      "properties": {
        "clock": {"const": "synthetic_monotonic_smoke"},
        "highest_trackable_ns": {"type": "integer", "minimum": 1},
        "significant_digits": {"type": "integer", "minimum": 1, "maximum": 5},
        "modes": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "enum": ["closed_loop", "open_loop"]}
        }
      }
    },
    "canonical_gaps": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
