{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riverdb.io/schemas/benchmark/result-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "evidence_class",
    "run_id",
    "manifest_sha256",
    "samples_sha256",
    "workload_sha256",
    "sample_count",
    "status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "result"},
    "evidence_class": {"const": "local_smoke"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "samples_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workload_sha256": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "sample_count": {"type": "integer", "minimum": 1},
    "status": {"const": "developer_smoke_not_promotion_evidence"}
  }
}
