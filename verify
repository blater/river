#!/bin/sh
set -eu

river_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -n "${RIVER_GRADLE_HOME:-}" ]; then
  GRADLE_USER_HOME=$RIVER_GRADLE_HOME
elif [ -z "${GRADLE_USER_HOME:-}" ]; then
  GRADLE_USER_HOME="$river_root/.river-gradle"
fi

export GRADLE_USER_HOME
"$river_root/gradle/verify-reproducible-archives.sh"

case "${RIVER_GRADLE_OFFLINE:-}" in
  "")
    exec "$river_root/gradlew" --no-daemon clean check "$@"
    ;;
  true)
    exec "$river_root/gradlew" --no-daemon --offline clean check "$@"
    ;;
  *)
    echo "RIVER_GRADLE_OFFLINE must be 'true' or unset" >&2
    exit 2
    ;;
esac
